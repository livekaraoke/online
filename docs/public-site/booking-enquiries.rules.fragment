// MERGE INSIDE match /databases/{database}/documents in the existing rules.
// Not a replacement for the project's rules. See SECURITY-ROLLOUT.md.
function lkPlain(value, maximum) {
  return value is string && value.size() <= maximum &&
    !value.matches('[\\s\\S]*[<>][\\s\\S]*') &&
    !value.matches('[\\s\\S]*[\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F][\\s\\S]*');
}
function validPublicBookingEnquiry() {
  let d = request.resource.data;
  let keys = ['status','source','sourceKey','type','performerType','name','email',
    'phone','eventType','preferredDate','venueOrLocality','company',
    'estimatedGuests','message','pageUrl','createdAt','updatedAt'];
  return d.keys().hasAll(keys) && d.keys().hasOnly(keys) &&
    d.status == 'pending' && d.performerType == d.type &&
    ((d.source == 'Live Karaoke Website' && d.sourceKey == 'live-karaoke' && d.type == 'Live Karaoke') ||
     (d.source == 'Billy Lee Website' && d.sourceKey == 'billylee26' && d.type == 'Solo') ||
     (d.source == 'Roxanna Website' && d.sourceKey == 'roxanna26' && d.type == 'Roxanna')) &&
    lkPlain(d.name,80) && d.name.matches('.*[^\\s].*') &&
    lkPlain(d.email,120) && d.email.matches('^[^\\s@/]+@[^\\s@/]+\\.[^\\s@/]+$') &&
    lkPlain(d.phone,50) &&
    d.eventType in ['Venue / Bar / Restaurant','Corporate Event','Wedding',
      'Private Party','Hotel / Resort','Festival / Public Event','Other'] &&
    lkPlain(d.preferredDate,10) &&
    (d.preferredDate == '' || d.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) &&
    lkPlain(d.venueOrLocality,140) && lkPlain(d.company,120) &&
    (d.estimatedGuests == null || (d.estimatedGuests is int &&
      d.estimatedGuests >= 0 && d.estimatedGuests <= 100000)) &&
    lkPlain(d.message,1500) && d.message.matches('[\\s\\S]*[^\\s][\\s\\S]*') &&
    lkPlain(d.pageUrl,2048) && d.pageUrl.matches('https://[^\\s]+') &&
    (d.sourceKey != 'live-karaoke' || d.pageUrl in ['https://livekaraoke.eu/','https://www.livekaraoke.eu/','https://livekaraoke.github.io/online/']) &&
    d.createdAt is timestamp && d.updatedAt is timestamp &&
    d.createdAt == request.time && d.updatedAt == request.time;
}
function validBookingCooldown(enquiryId) {
  let receipt = getAfter(/databases/$(database)/documents/publicBookingLimits/$(request.resource.data.email.lower())).data;
  return receipt.enquiryId == enquiryId && receipt.submittedAt == request.time;
}
match /publicBookingLimits/{email} {
  allow read, delete: if isOwner();
  allow create, update: if request.resource.data.keys().hasOnly(['enquiryId','submittedAt']) &&
    request.resource.data.enquiryId is string &&
    request.resource.data.submittedAt == request.time &&
    (!exists(/databases/$(database)/documents/publicBookingLimits/$(email)) ||
      resource.data.submittedAt + duration.value(60, 's') <= request.time) &&
    getAfter(/databases/$(database)/documents/bookingEnquiries/$(request.resource.data.enquiryId)).data.email.lower() == email &&
    getAfter(/databases/$(database)/documents/bookingEnquiries/$(request.resource.data.enquiryId)).data.createdAt == request.time;
}
match /bookingEnquiries/{enquiryId} {
  allow create: if validPublicBookingEnquiry() && validBookingCooldown(enquiryId);
  allow read, update, delete: if isOwner();
}
